    bit_from : 7;
    bit_to : 0;
  }
  type ("prog") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }

  cell ("efuse_async_mem_1x8") {
    area : 1712.255 
    is_macro_cell : true;
    pin("ready") {
      direction : output;
      capacitance : 0.0035;
      timing() {
        related_pin : "reset_n";
        timing_type : combinational;
	cell_rise(template_1) {
          index_1("0.00100,  0.01462,  0.06242,  0.15370,  0.29590,  0.49540,  0.75800,  1.08900,  1.49300,  1.97400");
          values("30.17520,30.20716,30.30454,30.48254,30.76061,31.15060,31.66279,32.31060,33.10054,34.03779");
	}
	rise_transition(template_1) {
