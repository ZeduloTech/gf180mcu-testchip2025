          values("29.16256,29.19249,29.27383,29.39936,29.57666,29.81913,30.13704,30.53788,31.02688,31.61005");
	}
	fall_transition(template_1) {
          index_1("0.00100,  0.01462,  0.06242,  0.15370,  0.29590,  0.49540,  0.75800,  1.08900,  1.49300,  1.97400");
          values("0.09030,0.12212,0.21728,0.38711,0.66382,1.06417,1.59917,2.27717,3.10683,4.09300");
	}
      }
    }
    pin("reset_n") {
      direction : input;
      capacitance : 0.1179;
    }
    bus("out") {
      bus_type : out;
      direction : output;
      capacitance : 0.0000;
    pin("out[7]") {
      direction : output;
      capacitance : 0.0040;
    }
    pin("out[6]") {
      direction : output;
      capacitance : 0.0014;
    }
    pin("out[5]") {
      direction : output;
      capacitance : 0.0032;
    }
    pin("out[4]") {
      direction : output;
      capacitance : 0.0029;
    }
    pin("out[3]") {
      direction : output;
      capacitance : 0.0030;
    }
    pin("out[2]") {
      direction : output;
      capacitance : 0.0034;
    }
    pin("out[1]") {
      direction : output;
      capacitance : 0.0034;
    }
    pin("out[0]") {
      direction : output;
      capacitance : 0.0057;
    }
    }
    bus("prog") {
      bus_type : prog;
      direction : input;
      capacitance : 0.0000;
    pin("prog[7]") {
      direction : input;
