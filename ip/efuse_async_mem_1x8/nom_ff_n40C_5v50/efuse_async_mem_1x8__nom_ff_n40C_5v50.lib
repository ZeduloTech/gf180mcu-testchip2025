library (efuse_async_mem_1x8) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : -40.0;
  nom_voltage                    : 5.50;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00100,  0.01394,  0.05934,  0.14610,  0.28120,  0.47070,  0.72010,  1.03400,  1.41800,  1.87500");
  }
  type ("out") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }
  type ("prog") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }

  cell ("efuse_async_mem_1x8") {
    area : 1712.255 
    is_macro_cell : true;
    pin("ready") {
      direction : output;
      capacitance : 0.0037;
      timing() {
        related_pin : "reset_n";
        timing_type : combinational;
	cell_rise(template_1) {
          index_1("0.00100,  0.01394,  0.05934,  0.14610,  0.28120,  0.47070,  0.72010,  1.03400,  1.41800,  1.87500");
          values("9.30387,9.31514,9.35024,9.41753,9.52372,9.67348,9.87164,10.12084,10.42515,10.78880");
	}
	rise_transition(template_1) {
          index_1("0.00100,  0.01394,  0.05934,  0.14610,  0.28120,  0.47070,  0.72010,  1.03400,  1.41800,  1.87500");
          values("0.03497,0.05019,0.10801,0.22607,0.41133,0.67159,1.01532,1.44800,1.97632,2.60532");
	}
	cell_fall(template_1) {
          index_1("0.00100,  0.01394,  0.05934,  0.14610,  0.28120,  0.47070,  0.72010,  1.03400,  1.41800,  1.87500");
          values("9.03455,9.04547,9.07508,9.12227,9.19074,9.28581,9.41100,9.56908,9.76199,9.99214");
	}
	fall_transition(template_1) {
          index_1("0.00100,  0.01394,  0.05934,  0.14610,  0.28120,  0.47070,  0.72010,  1.03400,  1.41800,  1.87500");
          values("0.03360,0.04563,0.08055,0.14530,0.25204,0.40712,0.61442,0.87461,1.19393,1.57300");
	}
      }
    }
    pin("reset_n") {
      direction : input;
      capacitance : 0.1143;
    }
    bus("out") {
      bus_type : out;
      direction : output;
      capacitance : 0.0000;
    pin("out[7]") {
      direction : output;
      capacitance : 0.0043;
    }
    pin("out[6]") {
      direction : output;
      capacitance : 0.0016;
    }
    pin("out[5]") {
      direction : output;
      capacitance : 0.0035;
    }
    pin("out[4]") {
      direction : output;
      capacitance : 0.0032;
    }
    pin("out[3]") {
      direction : output;
      capacitance : 0.0032;
    }
    pin("out[2]") {
      direction : output;
      capacitance : 0.0038;
    }
    pin("out[1]") {
      direction : output;
      capacitance : 0.0037;
    }
    pin("out[0]") {
      direction : output;
      capacitance : 0.0062;
    }
    }
    bus("prog") {
      bus_type : prog;
      direction : input;
      capacitance : 0.0000;
    pin("prog[7]") {
      direction : input;
      capacitance : 0.0142;
    }
    pin("prog[6]") {
      direction : input;
      capacitance : 0.0121;
    }
    pin("prog[5]") {
      direction : input;
      capacitance : 0.0131;
    }
    pin("prog[4]") {
      direction : input;
      capacitance : 0.0140;
    }
    pin("prog[3]") {
      direction : input;
      capacitance : 0.0135;
    }
    pin("prog[2]") {
      direction : input;
      capacitance : 0.0123;
    }
    pin("prog[1]") {
      direction : input;
      capacitance : 0.0149;
    }
    pin("prog[0]") {
      direction : input;
      capacitance : 0.0130;
    }
    }
  }

}
