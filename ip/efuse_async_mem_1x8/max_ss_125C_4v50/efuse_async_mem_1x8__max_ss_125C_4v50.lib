          values("29.27865,29.30859,29.38994,29.51548,29.69278,29.93524,30.25315,30.65397,31.14297,31.72616");
	}
	fall_transition(template_1) {
          index_1("0.00100,  0.01462,  0.06242,  0.15370,  0.29590,  0.49540,  0.75800,  1.08900,  1.49300,  1.97400");
          values("0.09043,0.12224,0.21736,0.38715,0.66383,1.06418,1.59918,2.27718,3.10682,4.09300");
	}
      }
    }
    pin("reset_n") {
      direction : input;
      capacitance : 0.1225;
    }
    bus("out") {
      bus_type : out;
      direction : output;
      capacitance : 0.0000;
    pin("out[7]") {
      direction : output;
      capacitance : 0.0047;
    }
    pin("out[6]") {
      direction : output;
      capacitance : 0.0017;
    }
    pin("out[5]") {
      direction : output;
      capacitance : 0.0038;
    }
    pin("out[4]") {
      direction : output;
      capacitance : 0.0036;
    }
    pin("out[3]") {
      direction : output;
      capacitance : 0.0036;
    }
    pin("out[2]") {
      direction : output;
      capacitance : 0.0042;
    }
    pin("out[1]") {
      direction : output;
      capacitance : 0.0041;
    }
    pin("out[0]") {
      direction : output;
      capacitance : 0.0069;
    }
    }
    bus("prog") {
      bus_type : prog;
      direction : input;
      capacitance : 0.0000;
    pin("prog[7]") {
      direction : input;
