    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }
  type ("prog") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }

  cell ("efuse_async_mem_1x8") {
    area : 1712.255 
    is_macro_cell : true;
    pin("ready") {
      direction : output;
      capacitance : 0.0041;
      timing() {
        related_pin : "reset_n";
        timing_type : combinational;
	cell_rise(template_1) {
          index_1("0.00100,  0.01462,  0.06242,  0.15370,  0.29590,  0.49540,  0.75800,  1.08900,  1.49300,  1.97400");
          values("30.28858,30.32055,30.41794,30.59591,30.87395,31.26395,31.77607,32.42395,33.21391,34.15107");
	}
	rise_transition(template_1) {
          index_1("0.00100,  0.01462,  0.06242,  0.15370,  0.29590,  0.49540,  0.75800,  1.08900,  1.49300,  1.97400");
          values("0.09856,0.14249,0.29684,0.61056,1.10996,1.81100,2.73016,3.90076,5.31088,7.00276");
	}
	cell_fall(template_1) {
