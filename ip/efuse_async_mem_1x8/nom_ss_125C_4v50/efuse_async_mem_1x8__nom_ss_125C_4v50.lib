          values("0.09845,0.14240,0.29679,0.61055,1.10995,1.81100,2.73021,3.90068,5.31084,7.00268");
	}
	cell_fall(template_1) {
          index_1("0.00100,  0.01462,  0.06242,  0.15370,  0.29590,  0.49540,  0.75800,  1.08900,  1.49300,  1.97400");
          values("29.21496,29.24490,29.32624,29.45177,29.62907,29.87154,30.18946,30.59028,31.07928,31.66246");
	}
	fall_transition(template_1) {
          index_1("0.00100,  0.01462,  0.06242,  0.15370,  0.29590,  0.49540,  0.75800,  1.08900,  1.49300,  1.97400");
          values("0.09036,0.12218,0.21732,0.38713,0.66382,1.06418,1.59918,2.27718,3.10682,4.09300");
	}
      }
    }
    pin("reset_n") {
      direction : input;
      capacitance : 0.1200;
    }
    bus("out") {
      bus_type : out;
      direction : output;
      capacitance : 0.0000;
    pin("out[7]") {
      direction : output;
      capacitance : 0.0043;
    }
    pin("out[6]") {
      direction : output;
      capacitance : 0.0016;
    }
    pin("out[5]") {
      direction : output;
      capacitance : 0.0035;
    }
    pin("out[4]") {
      direction : output;
      capacitance : 0.0032;
    }
    pin("out[3]") {
      direction : output;
      capacitance : 0.0032;
    }
    pin("out[2]") {
      direction : output;
      capacitance : 0.0038;
    }
    pin("out[1]") {
      direction : output;
      capacitance : 0.0037;
    }
    pin("out[0]") {
      direction : output;
      capacitance : 0.0062;
    }
    }
    bus("prog") {
      bus_type : prog;
      direction : input;
      capacitance : 0.0000;
    pin("prog[7]") {
      direction : input;
      capacitance : 0.0150;
    }
    pin("prog[6]") {
      direction : input;
      capacitance : 0.0128;
    }
    pin("prog[5]") {
