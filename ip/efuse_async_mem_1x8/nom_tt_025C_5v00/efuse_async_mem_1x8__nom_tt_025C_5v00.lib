    }
    pin("out[3]") {
      direction : output;
      capacitance : 0.0032;
    }
    pin("out[2]") {
      direction : output;
      capacitance : 0.0038;
    }
    pin("out[1]") {
      direction : output;
      capacitance : 0.0037;
    }
    pin("out[0]") {
      direction : output;
      capacitance : 0.0062;
    }
    }
    bus("prog") {
      bus_type : prog;
