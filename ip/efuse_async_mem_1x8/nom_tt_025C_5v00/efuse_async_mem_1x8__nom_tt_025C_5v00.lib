          values("0.05169,0.06990,0.12403,0.22233,0.38250,0.61796,0.93033,1.32313,1.80325,2.37900");
	}
      }
    }
    pin("reset_n") {
      direction : input;
      capacitance : 0.1166;
    }
    bus("out") {
      bus_type : out;
      direction : output;
      capacitance : 0.0000;
    pin("out[7]") {
      direction : output;
      capacitance : 0.0043;
    }
    pin("out[6]") {
      direction : output;
