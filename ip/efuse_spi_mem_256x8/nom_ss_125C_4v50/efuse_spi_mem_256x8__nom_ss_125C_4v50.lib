library (efuse_spi_mem_256x8) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 125.0;
  nom_voltage                    : 4.50;


  cell ("efuse_spi_mem_256x8") {
    area : 86068.781 
    is_macro_cell : true;
    pin("clk_i") {
      direction : input;
      capacitance : 0.0229;
    }
    pin("npor") {
      direction : input;
      capacitance : 0.0256;
    }
    pin("spi_clk") {
      direction : input;
      capacitance : 0.0449;
    }
    pin("spi_csn") {
      direction : input;
      capacitance : 0.0208;
    }
    pin("spi_miso") {
      direction : output;
      capacitance : 0.0045;
    }
    pin("spi_mosi") {
      direction : input;
      capacitance : 0.0078;
    }
  }

}
